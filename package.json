{
  "name": "strand",
  "version": "0.1.0",
  "private": true,
  "description": "Career memory store for interviews, resumes, and reviews",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
